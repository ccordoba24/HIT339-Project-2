@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Borrowing statistics";
}

<div class="container p-4">
    <h1>Borrowing statistics</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Borrowings</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.Date.ToShortDateString()</td>
                    <td>@row.Count</td>
                </tr>
            }
        </tbody>
    </table>
</div>
