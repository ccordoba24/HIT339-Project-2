<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library_App</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Library_App.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-decoration-underline"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Library App
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("Receptionist") ||
                             User.IsInRole("Manager"))

                            {
                                <li class="nav-item">
                                <a class="nav-link text-dark fw-bold"
                                      asp-controller="Borrowers"
                                      asp-action="Index">
                                       Borrowers
                                    </a>
                                </li>

                                <li class="nav-item">
                                <a class="nav-link text-dark fw-bold"
                                       asp-controller="Loans"
                                       asp-action="Index">
                                         Loans
                                    </a>
                                </li>

                                <li class="nav-item">
                                <a class="nav-link text-dark fw-bold"
                                       asp-controller="Books"
                                       asp-action="Index">
                                        Books
                                    </a>
                                </li>
                                <li class="nav-item">
                                <a class="nav-link text-dark fw-bold"
                                       asp-controller="Music"
                                       asp-action="Index">
                                         Music
                                    </a>
                                </li>

                                <li class="nav-item">
                                <a class="nav-link text-dark fw-bold"
                                       asp-controller="Toys"
                                       asp-action="Index">
                                         Toys
                                    </a>
                                </li>
                            }

                        @if (User.IsInRole("Manager"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-bold"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">
                                    Manager reports
                                </a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Statistics"
                                           asp-action="Borrowing">
                                            Borrowing statistics
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Statistics"
                                           asp-action="ItemStatus">
                                            Item status statistics
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Statistics"
                                           asp-action="Fines">
                                            Fine statistics
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold"
                               asp-controller="Search"
                               asp-action="Index">
                                Search Library
                            </a>
                        </li>


                     </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid site-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>


    <footer class="border-top footer site-footer text-muted">
        <div class="container-fluid footer-content">
            &copy; 2026 - Library App -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>
