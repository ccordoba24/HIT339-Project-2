@model LibraryApp.Models.SearchViewModel

@{
    ViewData["Title"] = "Search";
}

<h1>Search Library</h1>

<form asp-controller="Search"
      asp-action="Index"
      method="get"
      class="row g-2 mb-4">

    <div class="col-md-6">
        <label for="query" class="form-label">
            Search term
        </label>

        <input type="search"
               id="query"
               name="query"
               value="@Model.Query"
               class="form-control"
               placeholder="Enter a title, author, artist, or manufacturer" />
    </div>

    <div class="col-md-3">
        <label for="category" class="form-label">
            Category
        </label>

        <select id="category"
                name="category"
                class="form-select">
            <option value="Books"
                    selected="@(Model.Category == "Books")">
                Books
            </option>

            <option value="Music"
                    selected="@(Model.Category == "Music")">
                Music
            </option>

            <option value="Toys"
                    selected="@(Model.Category == "Toys")">
                Toys
            </option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit"
                class="btn btn-primary">
            Search
        </button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Query))
{
    <h2>
        Results for "@Model.Query" in @Model.Category
    </h2>

    @if (Model.Category == "Books")
    {
        if (!Model.Books.Any())
        {
            <p>No books were found.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var book in Model.Books)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body">
                                <h2 class="h5">@book.Name</h2>

                                @if (!string.IsNullOrWhiteSpace(book.Description))
                                {
                                    <p>@book.Description</p>
                                }

                                <p class="mb-1">
                                    <strong>Author:</strong> @book.Author
                                </p>

                                <p class="mb-1">
                                    <strong>Genre:</strong> @book.Genre
                                </p>

                                <p class="mb-1">
                                    <strong>Library code:</strong>
                                    @book.LibraryCode
                                </p>

                                <p class="mb-0">
                                    <strong>Status:</strong>
                                    @book.Status
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>

        }
    }

    @if (Model.Category == "Music")
    {
        if (!Model.Music.Any())
        {
            <p>No music items were found.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var music in Model.Music)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body">
                                <h2 class="h5">@music.Name</h2>

                                @if (!string.IsNullOrWhiteSpace(music.Description))
                                {
                                    <p>@music.Description</p>
                                }

                                <p class="mb-1">
                                    <strong>Artist:</strong> @music.Artist
                                </p>

                                <p class="mb-1">
                                    <strong>Album:</strong> @music.Album
                                </p>

                                <p class="mb-1">
                                    <strong>Year:</strong> @music.Year
                                </p>

                                <p class="mb-1">
                                    <strong>Library code:</strong>
                                    @music.LibraryCode
                                </p>

                                <p class="mb-0">
                                    <strong>Status:</strong>
                                    @music.Status
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>

        }
    }

    @if (Model.Category == "Toys")
    {
        if (!Model.Toys.Any())
        {
            <p>No toys were found.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var toy in Model.Toys)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body">
                                <h2 class="h5">@toy.Name</h2>

                                @if (!string.IsNullOrWhiteSpace(toy.Description))
                                {
                                    <p>@toy.Description</p>
                                }

                                <p class="mb-1">
                                    <strong>Type:</strong> @toy.Type
                                </p>

                                <p class="mb-1">
                                    <strong>Minimum age:</strong> @toy.MinimumAge
                                </p>

                                <p class="mb-1">
                                    <strong>Manufacturer:</strong>
                                    @toy.Manufacturer
                                </p>

                                <p class="mb-1">
                                    <strong>Library code:</strong>
                                    @toy.LibraryCode
                                </p>

                                <p class="mb-0">
                                    <strong>Status:</strong>
                                    @toy.Status
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>

        }
    }
}
